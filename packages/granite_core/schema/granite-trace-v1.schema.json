{
  "$defs": {
    "RunInfo": {
      "additionalProperties": false,
      "description": "Facts about the whole run: workflow, status, task input and final output.",
      "properties": {
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "external_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "final_output": {
          "additionalProperties": true,
          "title": "Final Output",
          "type": "object"
        },
        "runtime": {
          "default": "granite",
          "title": "Runtime",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "default": "completed",
          "enum": [
            "completed",
            "errored"
          ],
          "title": "Status",
          "type": "string"
        },
        "task_input": {
          "additionalProperties": true,
          "title": "Task Input",
          "type": "object"
        },
        "workflow": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Workflow",
          "type": "string"
        }
      },
      "required": [
        "workflow"
      ],
      "title": "RunInfo",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "description": "One recorded agent action: what it read, received and produced.",
      "properties": {
        "agent": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Agent",
          "type": "string"
        },
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "kind": {
          "enum": [
            "llm",
            "tool",
            "code",
            "handoff"
          ],
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "outputs": {
          "additionalProperties": true,
          "title": "Outputs",
          "type": "object"
        },
        "params": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Params"
        },
        "prompt_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Hash"
        },
        "reads": {
          "items": {
            "type": "string"
          },
          "title": "Reads",
          "type": "array"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "step_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "agent",
        "kind"
      ],
      "title": "Step",
      "type": "object"
    }
  },
  "$id": "https://granite.example/schema/granite.trace-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Granite Trace v1: a run and its ordered steps, validated on construction.",
  "properties": {
    "run": {
      "$ref": "#/$defs/RunInfo"
    },
    "schema_version": {
      "const": "granite.trace/v1",
      "default": "granite.trace/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "maxItems": 500,
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "run"
  ],
  "title": "TraceV1",
  "type": "object"
}
