# Copy to .env (never commit .env). Everything is optional: the defaults run in recorded mode, free of cost.
GRANITE_LLM_MODE=auto            # recorded | live | auto
GRANITE_MODEL=llama3.2:3b
GRANITE_OLLAMA_URL=http://127.0.0.1:11434
# Hosted OpenAI-compatible endpoint instead of Ollama (set both or neither):
# GRANITE_OPENAI_BASE_URL=https://api.example.com/v1
# GRANITE_OPENAI_API_KEY=
# GRANITE_API_TOKEN=             # when set, every /api request needs Authorization: Bearer <token>
# GRANITE_DB_URL=sqlite:///./granite.db   # or a PostgreSQL URL
# GRANITE_RECORD=0               # 1 = also save live answers into the cassette
# GRANITE_RATE_LIMIT=120         # state-changing requests per minute per client; 0 disables
